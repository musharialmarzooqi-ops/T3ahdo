rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // غيّر هذا البريد لبريد حساب المسؤول اللي سوّيته في Authentication
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'mushari.almarzooqi@gmail.com';
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // التسجيل مفتوح إلا إذا المسؤول سكّره من لوحة التحكم
    function regOpen() {
      return !exists(/databases/$(database)/documents/config/site)
        || get(/databases/$(database)/documents/config/site).data.get('regOpen', true) != false;
    }

    // تسجيل كل مشارك: يشوفه ويعدّله صاحبه، والمسؤول يشوف ويعدّل الكل
    match /regs/{uid} {
      allow read, update, delete: if isAdmin() || isSelf(uid);
      allow create: if isAdmin() || (isSelf(uid) && regOpen());
    }

    // أرقام الإنجاز الجماعي (بدون أسماء): الكل يقرأ، وكل شخص يكتب رقمه، والمسؤول يكتب للكل
    match /tally/{uid} {
      allow read: if true;
      allow write: if isAdmin() || isSelf(uid);
    }

    // الإعلانات: الكل يقرأ، والمسؤول بس ينشر
    match /ann/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // إعدادات الملتقى (البرنامج، النصوص، فتح وإغلاق التسجيل): الكل يقرأ، والمسؤول بس يعدّل
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // طلبات رمز جديد: صاحب الطلب يرسله، والمسؤول يوافق أو يرفض
    match /resets/{uid} {
      allow create: if isSelf(uid);
      allow read: if isAdmin() || isSelf(uid);
      allow update, delete: if isAdmin();
    }

    // أرقام المسجلين (بدون أسماء): يُسأل عن رقم واحد بس عشان ننبّه اللي مسجّل من قبل، وما يقدر أحد يجيب القائمة
    match /phones/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (request.auth != null && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // الميزانية: خاصة بالمسؤول بس
    match /budget/{id} {
      allow read, write: if isAdmin();
    }

    // الرمز البديل بعد موافقة المسؤول: الدخول يحتاج يقرأه، والمسؤول بس يكتبه
    match /aliases/{phone} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
